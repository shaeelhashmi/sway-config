# Enable cursor animations (number is the fade length in ms, e.g., 200)
cursor_trail 200

# Adjust how fast the trailing dots fade out
cursor_trail_decay 0.1 0.4
# background_image /home/shaeel/Pictures/wallpapers/nyan_last.jpg
background_image_layout scaled

# Set the minimum distance the cursor must move for the trail to appear
cursor_trail_start_threshold 1
font_family FiraCode Nerd Font
window_padding_width 0 0 100 0
